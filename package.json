{
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-skill": "^0.0.1-rc.1 || 0.2.1-rc.5 || 0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "version": "1.1.0",
  "license": "MIT",
  "files": [
    "dist",
    "skills",
    "plugin.json",
    "README.md",
    "client/client.js",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "types": "dist/index.d.ts",
  "name": "@molamaker/dsh-mstack",
  "type": "module",
  "description": "DeepSeek Harness plugin: mstack's workflow skills, its state in the dsh-TUI footer, and the mola console in the web client",
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node --test client/ test/",
    "prepack": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mola-maker/dsh-mstack.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
